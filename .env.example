# Copy this file to `.env` and fill in real values.
# See readme.md > "Environment variables" for more detail.

# --- Core redaction service endpoints ---------------------------------------

# Azure OpenAI endpoint used for LLM-based text redaction, e.g.
# https://myazurefoundryresource.openai.azure.com/
OPENAI_ENDPOINT=

# Azure AI Vision endpoint used for image analysis (face/text detection)
AZURE_VISION_ENDPOINT=

# Endpoint for the separate signature_detector scoring service
SIGNATURE_DETECTOR_ENDPOINT=

# Name of the Azure Storage account used to read/write files being redacted
STORAGE_NAME=

# --- Messaging ---------------------------------------------------------------

# Azure Service Bus namespace (used by the receiver to enqueue redaction jobs)
AZURE_SERVICE_BUS_NAMESPACE=

# Connection string for the Service Bus namespace (used by the redactor/processor trigger binding)
AZURE_SERVICE_BUS_NAMESPACE_CONNECTION_STRING=

# --- Observability ------------------------------------------------------------

# Application Insights connection string. Required to run the Function Apps
# locally or run integration tests; can be left blank for unit tests.
APP_INSIGHTS_CONNECTION_STRING=

# --- E2E / perf test only (require PINS VPN + `az login`, see readme.md) -----

# E2E_STORAGE_ACCOUNT=
# E2E_CONTAINER_NAME=
# E2E_RUN_ID=
# E2E_FUNCTION_URL=
# E2E_FUNCTION_RECEIVER_BASE_URL=
# E2E_FUNCTION_PROCESSOR_BASE_URL=
# E2E_FUNCTION_KEY=
# E2E_AZURE_HTTP_LOGGING=
